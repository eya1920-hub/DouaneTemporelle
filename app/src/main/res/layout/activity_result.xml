<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#98E0B7"
    tools:context=".ResultActivity">

    <ImageView
        android:id="@+id/img_verdict_er"
        android:layout_width="212dp"
        android:layout_height="164dp"
        android:layout_marginTop="60dp"
        android:contentDescription="Verdict"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_check_er" />

    <TextView
        android:id="@+id/tv_msg_er"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="24dp"
        android:gravity="center"
        android:text="Bon voyage Eya Riahi !"
        android:textAlignment="center"
        android:textColor="#1E7A45"
        android:textSize="26sp"
        android:textStyle="bold|italic"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/img_verdict_er" />

    <TextView
        android:id="@+id/tv_sous_message_er"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="24dp"
        android:gravity="center"
        android:text="Profitez de votre voyage temporel ✨"
        android:textAlignment="center"
        android:textColor="#1F1F5A"
        android:textSize="19sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_msg_er" />

    <ImageView
        android:id="@+id/img_avion_er"
        android:layout_width="200dp"
        android:layout_height="130dp"
        android:layout_marginTop="52dp"
        android:contentDescription="Avion"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.53"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_sous_message_er"
        app:srcCompat="@drawable/avion_er" />

    <Button
        android:id="@+id/btn_nouveau_er"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="28dp"
        android:backgroundTint="#3D4FB8"
        android:text="🔄 Nouveau voyageur"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        app:cornerRadius="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>